# Backend
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=chillshootersgamecenter
USER_ACCOUNTS_COLLECTION=user_accounts
AUTH_SECRET=replace-with-a-long-random-secret

# Authentication email
# Production (Render free tier blocks SMTP): set BREVO_API_KEY to send over HTTPS.
# The sender (EMAIL_FROM, or EMAIL_USER) must be a verified sender in Brevo.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=Chill Shooters <your-email@example.com>
# Local dev fallback when BREVO_API_KEY is unset: Gmail SMTP with an app password
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# Contact form fallback over SMTP for local dev (optional when BREVO_API_KEY is set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@example.com
TO_EMAIL=support@chillshooters.com

# Optional uploads, payments, and ID scanning
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Online card payments: Stripe TEST MODE only (demo). Live keys are refused. Production would use
# a Philippine gateway such as Xendit, since Stripe does not onboard Philippine merchants.
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-key
# The matching publishable key, served to the payment page so it can show the card option next to
# GCash/bank or Xendit. Both keys must be test keys or the card option stays hidden.
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-test-publishable-key
# Online payment through Xendit, TEST MODE only: use the development secret key (xnd_development_…);
# production keys are refused. Players pay on Xendit's payment page and bookings confirm automatically.
# GCash and bank transfer with proof upload stay available next to it.
# Key: Xendit dashboard (Test mode) > Settings > API Keys > Generate secret key, with Money-in write access.
# Webhook: Settings > Webhooks > Invoices paid, URL https://<render-service>/api/xendit/webhook. Copy the
# "Callback verification token" from that page below. Without it, payments are still verified when the
# player returns to the site.
XENDIT_SECRET_KEY=xnd_development_your-xendit-test-secret-key
XENDIT_CALLBACK_TOKEN=your-xendit-callback-verification-token
# Optional: limit the payment page to these channels (each must be activated on the account), e.g.
# GCASH,PAYMAYA,CREDIT_CARD. Leave empty to show every channel the account has.
XENDIT_PAYMENT_METHODS=
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_VISION_KEY=your-azure-vision-key

# Approved booking pricing defaults (PHP)
ENTRANCE_FEE_PER_PLAYER=150
STANDARD_DEPOSIT_RATE=0.5
OWN_GEAR_DEPOSIT=350
CVSU_DISCOUNT_PERCENT=10
PRIVATE_SESSION_PRICE_MULTIPLIER=1

# Booking locks: a chosen slot is held this many minutes while the player books. A private field
# picked on step 1 is held for SLOT_BROWSING_HOLD_MINUTES, renewed while the booking page is open.
SLOT_HOLD_MINUTES=15
SLOT_BROWSING_HOLD_MINUTES=3
# Time to pay before an unpaid booking is released for anyone to take: minutes when the captain
# pays alone, hours when the team splits the payment (unpaid teammates are warned at 12h and 2h left)
PAYMENT_WINDOW_MINUTES=30
SPLIT_PAYMENT_WINDOW_HOURS=24

# Default prices staff see when adding field charges at the counter (they can change them per charge)
AMMO_RELOAD_PRICE=50
FIELD_MODIFICATION_FEE=500

# Approved player capacity per location and time slot
BOOKING_CAPACITY_SALAWAG_MORNING=200
BOOKING_CAPACITY_SALAWAG_AFTERNOON=190
BOOKING_CAPACITY_SALAWAG_EVENING=180
BOOKING_CAPACITY_LANGKAAN_MORNING=200
BOOKING_CAPACITY_LANGKAAN_AFTERNOON=190
BOOKING_CAPACITY_LANGKAAN_EVENING=180
BOOKING_CAPACITY_BINAN_MORNING=400
BOOKING_CAPACITY_BINAN_AFTERNOON=380
BOOKING_CAPACITY_BINAN_EVENING=360

# Frontend: set this to the deployed Render service URL when deploying to Vercel
VITE_API_URL=https://your-service.onrender.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Google sign-in redirect fallback (used when pop-ups are blocked). Set to the site's own domain,
# e.g. your-site.vercel.app, after adding https://your-site.vercel.app/__/auth/handler as an
# authorized redirect URI on the OAuth client in Google Cloud Console. Defaults to chill-shooters.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=
# Minutes of inactivity before a session is logged out (a warning shows one minute before)
VITE_SESSION_IDLE_MINUTES=30
# Hours of inactivity before a "Remember me" session is logged out
VITE_REMEMBERED_SESSION_IDLE_HOURS=24

# Chronograph (FPS) safety limits used by the marshal safety log
FPS_LIMIT_AEG=450
FPS_LIMIT_SNIPER=550

# Weather advisories: the day before each game the server checks the OpenWeatherMap 5-day forecast
# (free key from openweathermap.org) and emails booked players about thunderstorms, likely heavy
# rain, or strong wind. Without a key only manual advisories are available.
OPENWEATHER_API_KEY=
# Optional thresholds: rain chance (0-1) together with mm of rain per 3 hours, and wind in m/s.
WEATHER_RAIN_CHANCE_THRESHOLD=0.7
WEATHER_RAIN_MM_THRESHOLD=2.5
WEATHER_WIND_MS_THRESHOLD=17
# Optional field coordinates "lat,lon" if the defaults are off
# WEATHER_COORDS_SALAWAG=14.3260,120.9800
# WEATHER_COORDS_LANGKAAN=14.3070,120.9510
# WEATHER_COORDS_BINAN=14.3036,121.0781

# Deployed frontend URL (no trailing slash) used in emailed links, e.g. guardian approval links.
# When unset, the API uses the site the booking was made from.
PUBLIC_APP_URL=https://your-site.vercel.app

# Optional: Firebase web API key used to verify Google sign-in tokens (defaults to the app's public key)
FIREBASE_API_KEY=
