# Backend
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=chillshootersgamecenter
USER_ACCOUNTS_COLLECTION=user_accounts
AUTH_SECRET=replace-with-a-long-random-secret

# Authentication email
# Production (Render free tier blocks SMTP): set BREVO_API_KEY to send over HTTPS.
# The sender (EMAIL_FROM, or EMAIL_USER) must be a verified sender in Brevo.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=Chill Shooters <your-email@example.com>
# Local dev fallback when BREVO_API_KEY is unset: Gmail SMTP with an app password
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# Email via Brevo HTTPS API (used on Render, whose free tier blocks SMTP).
# EMAIL_FROM must be a sender verified in your Brevo account.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=no-reply@example.com

# Contact form fallback over SMTP for local dev (optional when BREVO_API_KEY is set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@example.com
TO_EMAIL=support@chillshooters.com

# Optional uploads, payments, and ID scanning
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
STRIPE_SECRET_KEY=your-stripe-secret-key
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_VISION_KEY=your-azure-vision-key

# Approved booking pricing defaults (PHP)
ENTRANCE_FEE_PER_PLAYER=150
STANDARD_DEPOSIT_RATE=0.5
OWN_GEAR_DEPOSIT=350
CVSU_DISCOUNT_PERCENT=10
PRIVATE_SESSION_PRICE_MULTIPLIER=1

# Booking locks: a chosen slot is held this many minutes while the player books, and a pending
# reservation keeps its slot this many hours while the team pays before it is released
SLOT_HOLD_MINUTES=15
PAYMENT_WINDOW_HOURS=24

# Default prices staff see when adding field charges at the counter (they can change them per charge)
AMMO_RELOAD_PRICE=100
LATE_CANCELLATION_FEE=350
FIELD_MODIFICATION_FEE=500

# Approved player capacity per location and time slot
BOOKING_CAPACITY_SALAWAG_MORNING=200
BOOKING_CAPACITY_SALAWAG_AFTERNOON=190
BOOKING_CAPACITY_SALAWAG_EVENING=180
BOOKING_CAPACITY_LANGKAAN_MORNING=200
BOOKING_CAPACITY_LANGKAAN_AFTERNOON=190
BOOKING_CAPACITY_LANGKAAN_EVENING=180
BOOKING_CAPACITY_BINAN_MORNING=400
BOOKING_CAPACITY_BINAN_AFTERNOON=380
BOOKING_CAPACITY_BINAN_EVENING=360

# Frontend: set this to the deployed Render service URL when deploying to Vercel
VITE_API_URL=https://your-service.onrender.com
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Minutes of inactivity before a session without "Remember me" is logged out
VITE_SESSION_IDLE_MINUTES=30

# Chronograph (FPS) safety limits used by the marshal safety log
FPS_LIMIT_AEG=450
FPS_LIMIT_SNIPER=550

# Optional: Firebase web API key used to verify Google sign-in tokens (defaults to the app's public key)
FIREBASE_API_KEY=
